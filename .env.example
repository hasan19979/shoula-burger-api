# انسخي هاد الملف باسم .env واملي القيم الحقيقية (لا ترفعيه لأي مكان عام)

# رابط الاتصال بقاعدة بيانات Neon (Postgres) — بتاخذيه من لوحة Neon بعد ما تعملي مشروع
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# مفتاح سري لتشفير رموز تسجيل الدخول (JWT) — اكتبي أي نص عشوائي طويل وخاص فيك
JWT_SECRET=change-this-to-a-long-random-secret-string

# البورت اللي السيرفر بيشتغل عليه محلياً (Render بيحدده هو تلقائياً بالإنتاج)
PORT=4000

# نطاقات مسموح لها تتواصل مع الـ API (الموقع ولوحة التحكم) — افصلي بينهم بفاصلة
ALLOWED_ORIGINS=http://localhost:5500,https://your-site-domain.com
